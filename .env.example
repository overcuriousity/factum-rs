# Optional configuration. factum reads .env from the user config directory
# (Linux: ~/.config/factum/.env, macOS: ~/Library/Application Support/factum/.env,
# Windows: %LOCALAPPDATA%\factum\.env), then from the current directory;
# real environment variables override both.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (the --log-level flag overrides this)
LOG_LEVEL=INFO

# Database file. Default: the per-user data directory
# (Linux: ~/.local/share/factum/factum.db, macOS: ~/Library/Application Support/factum/factum.db,
# Windows: %LOCALAPPDATA%\factum\factum.db)
# FACTUM_DB=/path/to/factum.db

# Folder for external copies of seals (signed tree heads). Put it on another medium (USB stick, network share):
# a seal only protects against removed entries if a copy exists outside the database.
# The folder must already exist; factum never creates it, so an unmounted medium is noticed.
# Default: the GUI setting "Seal Folder…", otherwise a "seals" folder next to the database.
# FACTUM_SEAL_DIR=/media/usb/factum-seals
